# `vp run dev:mock`: run the app against the in-browser mock backend in src/mocks/.
# No network, Supabase project, or GitHub account needed. Values here override .env.local.
#
# The mock Supabase URL must share the dev server's origin: "Sign in with GitHub" is a
# full-page navigation, and the app itself completes it at /mock-supabase/auth/v1/authorize.
VITE_SUPABASE_URL=http://localhost:5173/mock-supabase
VITE_SUPABASE_ANON_KEY=mock-anon-key
VITE_DEVICE_ID=mock-browser
