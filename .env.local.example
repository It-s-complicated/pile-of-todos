# =============================================================================
# DATABASE (for migrations only - used by Drizzle Kit CLI)
# NOT exposed to frontend - keep this secret!
# =============================================================================
DATABASE_URL=postgresql://user:password@host:5432/database

# =============================================================================
# FRONTEND RUNTIME (browser-visible Vite env vars)
# =============================================================================
# This app is frontend-only:
# - Supabase handles browser auth and browser writes
# - Electric handles browser read sync
# - No app-owned server runtime, proxy, or /api/* routes are required

# Supabase browser client configuration
VITE_SUPABASE_URL=https://<your-project>.supabase.co
VITE_SUPABASE_ANON_KEY=<your-publishable-anon-key>

# Electric browser read endpoint
VITE_ELECTRIC_SHAPE_URL=https://api.electric-sql.cloud/v1/shape

# =============================================================================
# APP CONFIGURATION
# =============================================================================
# Device identification attached to client mutation intents.
# Keep this stable per browser/device instance.
VITE_DEVICE_ID=desktop-chrome-001

# Approved GitHub provider_id used by the UI for allowlist diagnostics.
VITE_APPROVED_GITHUB_PROVIDER_ID=<approved-github-provider-id>

# =============================================================================
# SETUP INSTRUCTIONS
# =============================================================================
# 1. Create/configure your Supabase project for auth + writes.
# 2. Configure Electric to expose the todos shape for browser reads.
# 3. Copy this file to .env.local and fill in your values.
# 4. Run `vp dev` to test locally.
