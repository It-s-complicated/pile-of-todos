# =============================================================================
# DATABASE (for migrations only - used by Drizzle Kit CLI)
# NOT exposed to frontend - keep this secret!
# =============================================================================
DATABASE_URL=postgresql://user:password@host:5432/database

# =============================================================================
# ELECTRIC CLOUD (used by frontend - safe to expose with VITE_ prefix)
# =============================================================================
# Electric Cloud base URL (used for both reads and writes)
VITE_API_BASE_URL=https://<your-instance>.electric-sql.cloud

# Electric Cloud credentials (used for shape subscriptions)
VITE_ELECTRIC_SOURCE_ID=<your-source-id>
VITE_ELECTRIC_SECRET=<your-secret>

# =============================================================================
# APP CONFIGURATION
# =============================================================================
# Device identification (used for tracking which device created/modified todos)
# Should be unique per device/browser instance
VITE_DEVICE_ID=desktop-chrome-001

# =============================================================================
# SETUP INSTRUCTIONS
# =============================================================================
# 1. Sign up at https://electric-sql.cloud
# 2. Create a new instance and connect your Postgres database
# 3. Run migrations: npm run migrate:generate && npm run migrate
# 4. Copy this file to .env.local and fill in your values
# 5. Run `npm run dev` to test

# If these variables are not set, the app will fall back to LocalStorage-only mode
