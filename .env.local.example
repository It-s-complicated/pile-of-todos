# Electric Cloud Sync Configuration
# Get your instance URL from https://electric-sql.cloud after signing up

# Electric Cloud Shape URL (for reading/syncing data)
# This is the Electric Cloud shape endpoint that streams changes from Postgres
VITE_ELECTRIC_SHAPE_URL=https://<your-instance>.electric-sql.cloud/v1/shape

# Electric Cloud Proxy URL (for writes)
# This is your proxy endpoint that handles POST/PUT/DELETE operations
# When using Electric Cloud as a proxy, this is typically:
# - Your edge function (Vercel, Netlify, Cloudflare Workers)
# - A custom backend API that forwards to Electric Cloud
# - Electric Cloud's built-in proxy (if available for your plan)
VITE_ELECTRIC_PROXY_URL=https://<your-proxy>.electric-sql.cloud/v1/proxy

# Device identification (used for tracking which device created/modified todos)
# Should be unique per device/browser instance
VITE_DEVICE_ID=desktop-chrome-001

# Note: To set up Electric Cloud:
# 1. Sign up at https://electric-sql.cloud
# 2. Create a new instance and connect your Postgres database
# 3. Set up your proxy to handle writes and return transaction IDs (txid)
#    The proxy must:
#    - Accept POST/PUT/DELETE requests
#    - Forward to your database or Electric Cloud
#    - Return { txid: <transaction_id> } in the response
# 4. Copy this file to .env.local and fill in your values
# 5. Run `npm run dev` to test

# If these variables are not set, the app will fall back to LocalStorage-only mode

DATABASE_URL=
